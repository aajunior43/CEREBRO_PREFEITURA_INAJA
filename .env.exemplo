# ===================================================
# Configurações do Bot do Telegram
# ===================================================
# Copie este arquivo para .env e preencha os valores

# Token do bot gerado pelo @BotFather no Telegram
TELEGRAM_TOKEN=7123456789:AAHxyzSeuTokenAqui

# Seu chat_id pessoal (para restringir acesso ao bot)
# O sistema já usa 942288759 como destino padrão para o link externo.
# Para múltiplos usuários, separe por vírgula: 942288759,789012
TELEGRAM_CHAT_ID=942288759

# URL do servidor Flask local (padrão: http://localhost:5000)
# Só altere se rodar em porta diferente
SERVER_URL=http://localhost:5000

# ===================================================
# Configurações do Cloudflare Tunnel (Opcional)
# ===================================================
# Para usar o tunnel automático, execute bot_completo.bat
# O link externo será enviado automaticamente pelo bot

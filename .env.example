# ============================================================
# Configurações do Sistema de Empenhos
# Prefeitura Municipal de Inajá
# ============================================================

# ── Servidor ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
APP_RELOADER=false

# ── Segurança ───────────────────────────────────────────────
# IMPORTANTE: Gerar chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-forte-aqui-minimo-32-caracteres

# Senha da área administrativa
ADM_PASSWORD=sua-senha-admin-forte

# ── Banco de Dados ──────────────────────────────────────────
DATABASE_URL=sqlite:///empenhos.db

# ── OpenRouter (IA) ─────────────────────────────────────────
# Obter chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelos padrão
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Configurações de requisição
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BACKOFF_BASE=1.5
OPENROUTER_CACHE_TTL_SECONDS=900

# Headers personalizados
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=CEREBRO_PREFEITURA

# ── Telegram (Notificações) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Autentique (Assinaturas Digitais) ───────────────────────
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_SANDBOX=true

# ── Backup Automático ───────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=backups

# ── Performance ─────────────────────────────────────────────
# Tamanho do cache de arquivos estáticos (MB)
STATIC_CACHE_SIZE_MB=50

# Número de conexões no pool do banco
DB_POOL_SIZE=5

# ── Logs ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=3
